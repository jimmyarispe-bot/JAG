{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@academyos": ["./packages/academyos/index.ts"],
      "@academyos/*": ["./packages/academyos/*"],
      "@studio": ["./packages/studio/index.ts"],
      "@studio/*": ["./packages/studio/*"],
      "@mr-jag": ["./packages/platform/mr-jag/index.ts"],
      "@mr-jag/*": ["./packages/platform/mr-jag/*"],
      "@evolution": ["./packages/platform/evolution/index.ts"],
      "@evolution/*": ["./packages/platform/evolution/*"],
      "@innovation": ["./packages/platform/innovation/index.ts"],
      "@innovation/*": ["./packages/platform/innovation/*"],
      "@organization": ["./packages/platform/organization/index.ts"],
      "@organization/*": ["./packages/platform/organization/*"],
      "@finance": ["./packages/platform/finance/index.ts"],
      "@finance/*": ["./packages/platform/finance/*"],
      "@cfo": ["./packages/platform/cfo/index.ts"],
      "@cfo/*": ["./packages/platform/cfo/*"],
      "@knowledge": ["./packages/platform/knowledge/index.ts"],
      "@knowledge/*": ["./packages/platform/knowledge/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "tests", "vitest.config.ts"]
}
