{
  "name": "school-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:platform && npm run validate:admissions && npm run validate:workflow && npm run validate:decision && npm run validate:events && npm run validate:intelligence-graph && npm run validate:automation && npm run validate:ulr && npm run validate:hierarchy && npm run validate:execution-engine && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "validate:platform": "tsx scripts/validate-platform-registry.mts",
    "validate:admissions": "tsx scripts/validate-admissions-registry.mts",
    "validate:workflow": "tsx scripts/validate-platform-workflow-registry.mts",
    "validate:decision": "tsx scripts/validate-platform-decision-registry.mts",
    "validate:events": "tsx scripts/validate-platform-event-registry.mts",
    "validate:intelligence-graph": "tsx scripts/validate-platform-intelligence-graph-registry.mts",
    "validate:automation": "tsx scripts/validate-platform-automation-registry.mts",
    "validate:ulr": "tsx scripts/validate-platform-ulr-registry.mts",
    "validate:hierarchy": "tsx scripts/validate-platform-hierarchy-registry.mts",
    "validate:execution-engine": "tsx scripts/validate-platform-execution-engine.mts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "playwright test",
    "cert:instructions": "node scripts/certification-run-instructions.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
